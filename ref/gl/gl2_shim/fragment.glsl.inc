"#if VER <= 300\n"
"#define layout(x)\n"
"#endif\n"
"#if VER < 300\n"
"#define out attribute\n"
"#define in varying\n"
"#define texture texture2D\n"
"#endif\n"
"#if VER >= 130 || VER == 100\n"
"precision mediump float;\n"
"#endif\n"
"#if VER == 100\n"
"#define PREC mediump\n"
"#else\n"
"#define PREC\n"
"#endif\n"
"#if ATTR_TEXCOORD0\n"
"uniform sampler2D uTex0;\n"
"#endif\n"
"#if ATTR_TEXCOORD1\n"
"uniform sampler2D uTex1;\n"
"#endif\n"
"#if FEAT_ALPHA_TEST\n"
"uniform float uAlphaTest;\n"
"#endif\n"
"#if FEAT_FOG\n"
"uniform PREC vec4 uFog;\n"
"uniform PREC vec4 uFogParams;\n"
"in PREC vec3 vFogPosition;\n"
"#endif\n"
"uniform PREC vec4 uColor;\n"
"#if ATTR_COLOR\n"
"in PREC vec4 vColor;\n"
"#endif\n"
"#if ATTR_TEXCOORD0\n"
"in PREC vec2 vTexCoord0;\n"
"#endif\n"
"#if ATTR_TEXCOORD1\n"
"in PREC vec2 vTexCoord1;\n"
"#endif\n"
"#if ATTR_NORMAL\n"
"in PREC vec2 vNormal;\n"
"#endif\n"
"#if VER >= 430\n"
"uniform int u3PointMode;\n"
"\n"
"// N64-style triangular interpolation of the three texels surrounding the\n"
"// sample point. Samples are taken at texel centers, preserving sampler wrap\n"
"// behavior while avoiding a fourth texture read.\n"
"vec4 N64ThreePointLevel(sampler2D tex, vec2 uv, int level)\n"
"{\n"
"    vec2 size = vec2(textureSize(tex, level));\n"
"    vec2 p = uv * size - vec2(0.5);\n"
"    vec2 base = floor(p);\n"
"    vec2 f = fract(p);\n"
"    float lowerTriangle = step(f.x + f.y, 1.0);\n"
"    vec2 q0 = base + vec2(1.0 - lowerTriangle);\n"
"    vec2 q1 = base + vec2(1.0, 0.0);\n"
"    vec2 q2 = base + vec2(0.0, 1.0);\n"
"    vec4 s0 = textureLod(tex, (q0 + vec2(0.5)) / size, float(level));\n"
"    vec4 s1 = textureLod(tex, (q1 + vec2(0.5)) / size, float(level));\n"
"    vec4 s2 = textureLod(tex, (q2 + vec2(0.5)) / size, float(level));\n"
"    vec3 w = vec3(\n"
"        mix(f.x + f.y - 1.0, 1.0 - f.x - f.y, lowerTriangle),\n"
"        mix(1.0 - f.y, f.x, lowerTriangle),\n"
"        mix(1.0 - f.x, f.y, lowerTriangle));\n"
"    return s0 * w.x + s1 * w.y + s2 * w.z;\n"
"}\n"
"\n"
"vec4 N64ThreePoint(sampler2D tex, vec2 uv)\n"
"{\n"
"    int levels = max(textureQueryLevels(tex), 1);\n"
"    float lod = clamp(textureQueryLod(tex, uv).y, 0.0, float(levels - 1));\n"
"    int level0 = int(floor(lod));\n"
"    if (u3PointMode == 1)\n"
"    {\n"
"        int level = min(int(floor(lod + 0.5)), levels - 1);\n"
"        return N64ThreePointLevel(tex, uv, level);\n"
"    }\n"
"    int level1 = min(level0 + 1, levels - 1);\n"
"    vec4 c0 = N64ThreePointLevel(tex, uv, level0);\n"
"    if (level1 == level0) return c0;\n"
"    vec4 c1 = N64ThreePointLevel(tex, uv, level1);\n"
"    return mix(c0, c1, fract(lod));\n"
"}\n"
"#endif\n"
"#if VER >= 300\n"
"out vec4 oFragColor;\n"
"#else\n"
"#define oFragColor gl_FragColor\n"
"#endif\n"
"void main()\n"
"{\n"
"#if ATTR_COLOR\n"
"PREC vec4 c = vColor;\n"
"#else\n"
"PREC vec4 c = uColor;\n"
"#endif\n"
"#if ATTR_TEXCOORD0\n"
"#if VER >= 430\n"
"if (u3PointMode > 0)\n"
"    c = c * N64ThreePoint(uTex0, vTexCoord0);\n"
"else\n"
"#endif\n"
"c = c * texture(uTex0, vTexCoord0);\n"
"#endif\n"
"#if ATTR_TEXCOORD1\n"
"c = c * texture(uTex1, vTexCoord1);\n"
"#endif\n"
"#if FEAT_ALPHA_TEST\n"
"if(c.a <= uAlphaTest)\n"
"discard;\n"
"#endif\n"
"#if FEAT_FOG\n"
"if (uFogParams.w > 0.5)\n"
"{\n"
"    float fogDist = (uFogParams.w > 1.5) ? length(vFogPosition) : abs(vFogPosition.z);\n"
"    float fogStart = uFogParams.x;\n"
"    float fogRange = max(uFogParams.y - fogStart, 0.001);\n"
"    float fogT = clamp((fogDist - fogStart) / fogRange, 0.0, 1.0);\n"
"    float curve = fogT;\n"
"    float exponent = max(uFog.w, 0.0) * fogRange;\n"
"    if (exponent > 0.000001)\n"
"    {\n"
"        float denominator = 1.0 - exp(-exponent);\n"
"        if (denominator > 0.000001)\n"
"            curve = (1.0 - exp(-exponent * fogT)) / denominator;\n"
"    }\n"
"    float fogAmount = clamp(curve * clamp(uFogParams.z, 0.0, 1.0), 0.0, 1.0);\n"
"    c.rgb = mix(c.rgb, uFog.rgb, fogAmount);\n"
""}\n"
"else\n"
"{\n"
"    float fogDist = gl_FragCoord.z / gl_FragCoord.w;\n"
"    float fogRate = clamp(exp(-uFog.w * fogDist), 0.0, 1.0);\n"
"    c.rgb = mix(uFog.rgb, c.rgb, fogRate);\n"
""}\n"
"#endif\n"
"oFragColor = c;\n"
"}\n"
